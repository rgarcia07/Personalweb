---
//src/components/Experience.astro
import "../styles/Experience.css";
import Portfolio from "../components/Portfolio.astro";


const { id } = Astro.props;
---

<section id={id} class="section-container w-[90%] max-w-[1200px] min-h-[500px] mx-auto ">
    <div class="grid grid-cols-3 ites-center w-full">
        <div class="justify-self-center md:justify-self-start">
            <h2>Experiencia</h2>
            <div class="
            w-fit 
            p-5 
            border-2 
            rounded-xl  
            border-none 
            shadow-[0_0_15px_rgba(255,255,255,0.1)] 
            bg-[#080517]">
                <div>
                    <p>"Experience 1"</p>
                </div>
                <div>
                    <p>"LUGAR EMP." <span>Fecha.</span></p>
                </div>
                <div>
                    <p class="">
                        Desarrollo de aplicaciones web, con React, Node.js y
                        bases de datos.
                    </p>
                </div>
            </div>
        </div>

        <div class="line-central hidden lg:block justify-self-center"></div>

        <div class="justify-self-center md:justify-self-end">
            <div>
                <Portfolio id="Portfolio"/>
            </div>
        </div>
    </div>
</section>
