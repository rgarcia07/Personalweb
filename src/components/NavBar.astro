---
import "../styles/NavBar.css";
import { Image } from "astro:assets";

import monjslogo from "../assets/monjslogo.png";
---

<header>
    <nav>
        <ul class="navbar">
            <!-- Icono / Logo -->
            <li class="absolute left-4 md:left-[100px] flex items-center">
                <a href="/">
                    <img
                        src={monjslogo.src}
                        alt="RD"
                        class="mt-[30px] w-[150px] h-[150px] object-contain"
                    />
                </a>
            </li>

            <!-- Enlaces -->
            <li><a href="#About">Sobre mí</a></li>
            <li><a href="#Experience">Experiencia</a></li>
            <li><a href="#Portfolio">Portafolio</a></li>
            <li><a href="#Contact">Contacto</a></li>
        </ul>
    </nav>
</header>
