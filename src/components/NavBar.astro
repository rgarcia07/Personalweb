---
import "../styles/NavBar.css";
import { Image } from "astro:assets";

import monjslogo from "../assets/monjslogo.png";
---

<header>
    <nav>
        <ul class="navbar flex flex-wrap items-center justify-center gap-3 sm:gap-6 relative py-2">
            <!-- Icono / Logo -->
            <li class="absolute left-2 sm:left-4 md:left-[100px] flex items-center">
                <a href="/">
                    <img
                        src={monjslogo.src}
                        alt="RD"
                        class="mt-2 sm:mt-4 md:mt-[30px] w-16 h-16 sm:w-24 sm:h-24 md:w-[150px] md:h-[150px] object-contain"
                    />
                </a>
            </li>

            <!-- Enlaces -->
            <li><a href="#About" class="text-sm sm:text-base">Sobre mí</a></li>
            <li><a href="#Experience" class="text-sm sm:text-base">Experiencia</a></li>
            <li><a href="#Portfolio" class="text-sm sm:text-base">Portafolio</a></li>
            <li><a href="#Contact" class="text-sm sm:text-base">Contacto</a></li>
        </ul>
    </nav>
</header>
