---
//src/components/About.astro
import "../styles/About.css";
import instagram from '../assets/instagram.png'
import logogit from '../assets/logogit.png'
import iconReact from '../assets/iconReact.png'
import iconTail from '../assets/iconTail.png'
import astroicon from '../assets/astroicon.png'
import Logoastro from '../assets/Astro.svg'



const { id } = Astro.props;
---

<section id={id}>
    <div class="about-title">
        <h2 class="title-about">Sobre mí</h2>
    </div>
    <div class="left-information">
        <div class="about-information">
            <div class="photo-about">
                <img class="" src="" alt="Photo-mine" />
            </div>
            <article class="information">
                <div class="personal-information">
                    <p>Soy un desarrollador principante en el ambito web,<br> apasionado por la tecnolgía, <br>
                        actualmente me enfoco en React, Astro <br> y constante aprendizaje en JS</p>
                </div>
                <div class="flex gap-5">
                    <div class="github-logo">
                        <a href="https://github.com/rgarcia07"><img class="mt-[30px] w-[40px] h-[40px]" src={logogit.src} alt="Logo-git" /></a>
                    </div>
                    <div class="insta-logo">
                        <a href="https://www.instagram.com/monjs.dev/"><img class="mt-[30px] w-[40px] h-[40px]" src={instagram.src} alt="Logo-insta" /></a>
                    </div>
                </div>
            </article>
        </div>
    </div>

    <div class="center-line"></div>

    <div class="right-information">
        <div title="technolohy-title">
            <h2 class="">Tecnologías</h2>
        </div>
        <div class="grid grid-cols-4 grid-rows-1 object-contain gap-10">
            <div class="Astro-logo">
                <a href=""><img class="mt-[50px] w-[60px] h-[60px]" src={Logoastro.src} alt="Logo-astro" /></a>
            </div>
            <div class="bg-transparent">
                <a href="https://es.react.dev/"><img class="mt-[50px] w-[60px] h-[60px]" src={iconReact.src} alt="Logo-React" /></a>
            </div>
            <div class="Tailwind-logo">
                <a href="https://tailwindcss.com/"><img class="mt-[50px] w-[60px] h-[60px]" src={iconTail.src} alt="Logo-Tailwind" /></a>
            </div>
        </div>
    </div>
</section>
