---
//src/components/Hero.astro
import "../styles/Hero.css";
import "@fontsource-variable/fraunces";
import "@fontsource-variable/fraunces/wght-italic.css";
import ArrowRight from "../assets/ArrowRight.svg";
import PerfilPhoto from "../assets/PerfilPhoto.jpeg"; 

const { id } = Astro.props;
---

<section id={id}>
    <div class="left-section">
        <div class="container-hero">
            <p class="text-welcome">
                ¡Hola! &#128075;.
            </p>
            <h1>
                Soy <span class="nombre">Ramón García</span>
            </h1>
            <h2>
                Diseño y construyo interfaces <br />
                
            </h2>

            <div class="my-information">
            <p>Web Developer Jr.</p>
            <p>Graduado en Ingenieria en Sistemas C. en "TSJ"</p>   
            <p>Abierto a aprender nuevas tecnologías y lenguajes.</p> 
            </div>

            <div class="buttons-info">
                <a href="#Portfolio">
                    <button class="btn-portafolio"
                        >Ver mi portafolio
                        <ArrowRight
                            width="25"
                            height="17"
                            class="text-blue-500"
                        />
                    </button></a
                >
                <a href="#Contact">
                    <button class="btn-write">Escribeme</button>
                </a>
            </div>
        </div>
    </div>
    <div class="right-section">
        <div class="container-photo">
            <img class="w-16 md:w-32 lg:w-85" src={PerfilPhoto.src} />
        </div>
    </div>
</section>


